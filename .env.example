# ============================================================
# Diginast Catalog — Environment Variables
# ============================================================
# Copy this file to .env and fill with real values.
# NEVER commit .env to git.

# --- Admin Auth ---
# Min 8 characters. Hashed with bcrypt(12) at boot.
ADMIN_PASSWORD=changeme123

# Min 32 characters. Used to sign JWT session tokens (HS256).
ADMIN_JWT_SECRET=generate-a-32+char-random-secret-here

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# --- Public ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- UploadThing (optional, for media uploads) ---
UPLOADTHING_SECRET=
NEXT_PUBLIC_UPLOADTHING_APP_ID=
